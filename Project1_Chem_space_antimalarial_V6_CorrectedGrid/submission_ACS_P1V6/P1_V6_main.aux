\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Combined polypharmacology--RRS prioritization of the 17-member cohort. $N_{\mathrm  {fav}}$ counts targets with a favorable within-target Vina estimate ($S_{\mathrm  {Vina}}\leq \qty {-6.0}{\kilo \calorie \per \mole }$); favorable targets are listed explicitly. Candidates are sorted by $N_{\mathrm  {fav}}$ and then by RRS$_{\mathrm  {mean}}$. The threshold is an operational prioritization device, not an experimental affinity cutoff, and the classes are the operational RRS categories of \Cref  {SM-tab:rrs_classes}.}}{11}{table.2}\protected@file@percent }
\newlabel{tab:dual_priority}{{2}{11}{Combined polypharmacology--RRS prioritization of the 17-member cohort. $N_{\mathrm {fav}}$ counts targets with a favorable within-target Vina estimate ($S_{\mathrm {Vina}}\leq \qty {-6.0}{\kilo \calorie \per \mole }$); favorable targets are listed explicitly. Candidates are sorted by $N_{\mathrm {fav}}$ and then by RRS$_{\mathrm {mean}}$. The threshold is an operational prioritization device, not an experimental affinity cutoff, and the classes are the operational RRS categories of \Cref {SM-tab:rrs_classes}}{table.2}{}}
\newlabel{tab:dual_priority@cref}{{[table][2][]2}{[1][11][]11}{}{}{}}

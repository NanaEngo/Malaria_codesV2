        """


# ============================================================================
# Utility rules
# ============================================================================

rule clean:
    """Remove all generated files"""
    shell:
        """
        rm -rf results/c*.txt results/c*.csv results/c13_human_dhfr_docking/
        rm -rf results/ligands/2d_diagrams/
        rm -f results/manuscript_calculations_summary.txt
        """


rule dry_run:
    """Show what would be done without executing"""
    run:
        print("Dry run: The following calculations would be executed:")
        print("  C1-C8: Pandas-based calculations")
        print("  C9-C12: RDKit-dependent calculations")
        print("  C13: Human DHFR decoy docking")
        print("  C14: 2D interaction diagrams")
        print("\nRun 'snakemake --cores 4' to execute all calculations.")

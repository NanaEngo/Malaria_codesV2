#!/bin/bash
#SBATCH --job-name=p2_setc_prod
#SBATCH --partition=production
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=12G
#SBATCH --time=48:00:00
#SBATCH --output=logs/p2_setc_prod_%j.log
#SBATCH --error=logs/p2_setc_prod_%j.err

# =============================================================================
# PRODUCTION MD for the 16 Set-C systems (10 ns each, single replicate).
#
# p2_setc_md_workflow.py is candidate-based: --n-candidates 2 selects the two
# bounded-pilot candidates (PP-01, PP-02) and iterates ALL targets/mutations
# (8 receptor states each) -> 16 prepared systems.  It must run as ONE job
# (an array would race on the same run directories).
#
# Launch AFTER the equilibration array completes:
#   sbatch --dependency=afterok:<EQUIL_JOB_ID> scripts/p2_setc_production.sbatch
# The task itself re-checks npt.gro per system and skips the run if
# equilibration is incomplete.
#
# Protocol (matches the equilibration fixes):
#   - grompp from npt.gro/npt.cpt (continuation), 10 ns, dt=0.002, 310.15 K,
#     1 bar (set_c_production.mdp generated by the workflow);
#   - mdrun CPU-only (-nb cpu -pme cpu -bonded cpu -update cpu) — the host
#     A4000 GPU crashes GROMACS update/constraint routines (rc=-6,
#     UpdateConstrainGpu), matching the parent study;
#   - P2_MD_EXECUTE_CONFIRM=I_UNDERSTAND for the authorized execution guard.
#
# 16 systems × 10 ns at 8 threads (~9-10 h each) ≈ 150-160 h sequential;
# a future arrayed runnner can split this, but the single-job form is the
# provably-correct execution path.
# =============================================================================

set -e
source /home/nanaengo/miniforge3/etc/profile.d/conda.sh
conda activate malaria_md 2>/dev/null || true

export P2_SETC_NTOMP=8
export P2_GMX_BIN=/home/nanaengo/miniforge3/envs/malaria_md/bin/gmx_mpi
export P2_SETC_ROOT=/home/nanaengo/Malaria_codesV2/Project2_Polypharmacology_MD_ValidationV2607/results/md_systems/set_c
export P2_MD_EXECUTE_CONFIRM=I_UNDERSTAND

cd /home/nanaengo/Malaria_codesV2/Project2_Polypharmacology_MD_ValidationV2607

SYSTEMS=(
  PP-01_PfCRT_K76A
  PP-01_PfCRT_K76T
  PP-01_PfCRT_WT
  PP-01_PfDHFR_C59R
  PP-01_PfDHFR_I164L
  PP-01_PfDHFR_N51I
  PP-01_PfDHFR_S108N
  PP-01_PfDHFR_WT
  PP-02_PfCRT_K76A
  PP-02_PfCRT_K76T
  PP-02_PfCRT_WT
  PP-02_PfDHFR_C59R
  PP-02_PfDHFR_I164L
  PP-02_PfDHFR_N51I
  PP-02_PfDHFR_S108N
  PP-02_PfDHFR_WT
)

echo "=== Set-C production MD (10 ns x 16 systems) ==="

# Guard: every system must be equilibrated before we start the workflow
MISSING=0
for SYS in "${SYSTEMS[@]}"; do
  if [ ! -f "$P2_SETC_ROOT/$SYS/npt.gro" ] || [ ! -s "$P2_SETC_ROOT/$SYS/npt.gro" ]; then
    echo "MISSING NPT: $SYS"
    MISSING=$((MISSING+1))
  fi
done
if [ "$MISSING" -gt 0 ]; then
  echo "ABORT: $MISSING/16 systems not equilibrated (npt.gro missing); exiting"
  exit 0
fi
echo "All 16 systems equilibrated. Launching workflow."

python scripts/p2_setc_md_workflow.py \
  --n-candidates 2 \
  --target-ns 10 \
  --replicates 1 \
  --auto-approved \
  --execute
RC=$?
echo "=== Set-C production workflow finished rc=$RC ==="
exit $RC

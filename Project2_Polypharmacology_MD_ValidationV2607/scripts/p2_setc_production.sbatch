#!/bin/bash
#SBATCH --job-name=p2_setc_prod
#SBATCH --partition=production
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=12G
#SBATCH --time=48:00:00
#SBATCH --array=0-15%4
#SBATCH --output=logs/p2_setc_prod_%A_%a.log
#SBATCH --error=logs/p2_setc_prod_%A_%a.err

# =============================================================================
# PRODUCTION MD array for the 16 Set-C systems (10 ns each, single replicate).
#
# Each array task (0-15) runs exactly ONE prepared system via the workflow's
# --array-index mode: the workflow filters its row list to the single
# candidate-target-mutation owned by this task (directory-name derived), so
# tasks never race on shared run directories.  Per-task status/manifest files
# are written (set_c_md_status_arrayNN.csv / ..._manifest_arrayNN.json).
#
# Launch AFTER the equilibration array completes:
#   sbatch --dependency=afterok:<EQUIL_JOB_ID> scripts/p2_setc_production.sbatch
# The task itself re-checks npt.gro per system and exits cleanly if
# equilibration is incomplete.
#
# Protocol (matches the equilibration fixes):
#   - grompp from npt.gro/npt.cpt (continuation), 10 ns, dt=0.002, 310.15 K,
#     1 bar (set_c_production.mdp generated by the workflow);
#   - mdrun CPU-only (-nb cpu -pme cpu -bonded cpu -update cpu via P2_GMX_FLAGS
#     semantics are handled inside md_execution_guard; -ntomp 8 explicit);
#   - P2_MD_EXECUTE_CONFIRM=I_UNDERSTAND for the authorized execution guard.
#
# ETA: ~9-10 h per 10 ns system at 8 threads; %4 concurrency -> ~40 h for the
# full 16-system array.
# =============================================================================

set -e
source /home/nanaengo/miniforge3/etc/profile.d/conda.sh
conda activate malaria_md 2>/dev/null || true

export P2_SETC_NTOMP=8
export P2_GMX_BIN=/home/nanaengo/miniforge3/envs/malaria_md/bin/gmx_mpi
export P2_SETC_ROOT=/home/nanaengo/Malaria_codesV2/Project2_Polypharmacology_MD_ValidationV2607/results/md_systems/set_c
export P2_MD_EXECUTE_CONFIRM=I_UNDERSTAND

cd /home/nanaengo/Malaria_codesV2/Project2_Polypharmacology_MD_ValidationV2607

SYS_DIRS=(
  PP-01_PfCRT_K76A
  PP-01_PfCRT_K76T
  PP-01_PfCRT_WT
  PP-01_PfDHFR_C59R
  PP-01_PfDHFR_I164L
  PP-01_PfDHFR_N51I
  PP-01_PfDHFR_S108N
  PP-01_PfDHFR_WT
  PP-02_PfCRT_K76A
  PP-02_PfCRT_K76T
  PP-02_PfCRT_WT
  PP-02_PfDHFR_C59R
  PP-02_PfDHFR_I164L
  PP-02_PfDHFR_N51I
  PP-02_PfDHFR_S108N
  PP-02_PfDHFR_WT
)

SYS="${SYS_DIRS[$SLURM_ARRAY_TASK_ID]}"
echo "=== Set-C production MD (10 ns): $SYS (array index $SLURM_ARRAY_TASK_ID) ==="

# Guard: equilibration must be complete for this system
if [ ! -f "$P2_SETC_ROOT/$SYS/npt.gro" ] || [ ! -s "$P2_SETC_ROOT/$SYS/npt.gro" ]; then
  echo "ABORT: $SYS has no npt.gro — equilibration incomplete; exiting"
  exit 0
fi

# Remove stale failure marker so a success is not masked
rm -f "$P2_SETC_ROOT/$SYS/production_failure.json"

python scripts/p2_setc_md_workflow.py \
  --n-candidates 2 \
  --target-ns 10 \
  --replicates 1 \
  --ntomp 8 \
  --array-index "$SLURM_ARRAY_TASK_ID" \
  --auto-approved \
  --execute
RC=$?
echo "=== $SYS production finished rc=$RC ==="
exit $RC

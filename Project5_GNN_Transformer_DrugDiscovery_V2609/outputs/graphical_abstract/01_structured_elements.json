            "font_size": 11,
            "font_weight": "bold",
            "arrow": "right_pointing"
          }
        }
      ],
      "question_text": "Can learned graph/sequence representations outperform ECFP4 fingerprints\non antimalarial natural products under chemical distribution shift?"
    },
    
    {
      "id": "B",
      "name": "THE_EXPERIMENT",
      "position": {
        "y_start": 30,
        "y_end": 65,
        "height_percent": 35
      },
      "workflow": [
        {
          "step": 1,
          "name": "Data",
          "icon": "database",
          "content": {
            "n_molecules": 19836,
            "source": "African antimalarial natural products",
            "example_structures": [
              "CN1C=NC2=C1C(=O)N(C(=O)N2C)C",
              "CC12CCC3C(C1CCC2O)CCC4=CC(=O)CCC34C",
              "C1=CC=C(C=C1)C(C(=O)O)N"
            ]
          },
          "label": "19,836 molecules\nAfrican antimalarial\nnatural products"
        },
        {
          "step": 2,
          "name": "Splits",
          "icon": "split_path",
          "content": {
            "random_split": {
              "description": "Stratified 5-fold",
              "icon": "shuffled_molecules"
            },
            "scaffold_split": {
              "description": "Bemis-Murcko groups held out",
              "icon": "framework_grouping",
              "note": "Whole scaffold groups → test folds"
            }
          },
          "label": "Random vs Scaffold\nSplit protocols"
        },
        {
          "step": 3,
          "name": "Models",
          "icon": "stacked_boxes",
          "content": [
            {
              "model": "ECFP4-RF",
              "description": "2048-bit fingerprint + 500 trees",
              "icon": "fingerprint",
              "color": "#2E86AB"
            },
            {
              "model": "GIN",
              "description": "Graph Isomorphism Network",
              "icon": "graph",
              "color": "#F18F01"
            },
            {
              "model": "GIN-TFP",
              "description": "+ Topological Fusion (Persistent Homology)",
              "icon": "topology",
              "color": "#8E44AD"
            },
            {
              "model": "GIN-TNE",
              "description": "+ Tensor Network Embeddings",
              "icon": "tensor",
              "color": "#9B59B6"
            },
            {
              "model": "ChemBERTa",
              "description": "Pretrained Transformer (SMILES)",
              "icon": "text",
              "color": "#E74C3C"
            }
          ],
          "label": "5 models\nevaluated"
        },
        {
          "step": 4,
          "name": "Evaluation",
          "icon": "roc_curve",
          "content": {
            "metric": "ROC AUC",
            "replication": "5 folds × 5 seeds = 25 replicates",
            "statistics": "Paired t-test + BH correction"
          },
          "label": "ROC AUC\n5×5 CV"
        }
      ]
    },
    
    {
      "id": "C",
      "name": "THE_RESULT",
      "position": {
        "y_start": 65,
        "y_end": 100,
        "height_percent": 35
      },
      "chart": {
        "type": "horizontal_bar",
        "title": "Mean ROC AUC under Scaffold Split",
        "x_axis": {
          "label": "ROC AUC",
          "range": [0.75, 0.85],
          "ticks": [0.75, 0.77, 0.79, 0.81, 0.83, 0.85]
        },
        "y_axis": {
          "label": "Model",
          "categories": [
            "ECFP4-RF",
            "GIN-TFP",
            "GIN-TNE",
            "GIN",
            "ChemBERTa"
          ]
        },
        "data": [
          {
            "model": "ECFP4-RF",
            "value": 0.8300,
            "error": 0.0023,
            "color": "#2E86AB",
            "significance": "reference",
            "styling": {
              "border": "bold",
              "fill": "solid",
              "pattern": "diagonal_hatching",
              "marker": "gold_star"
            }
          },
          {
            "model": "GIN-TFP",
            "value": 0.8138,
            "error": 0.0107,
            "color": "#8E44AD",
            "significance": "***",
            "delta_vs_baseline": -0.016,
            "p_value_adjusted": 0.0330
          },
          {
            "model": "GIN-TNE",
            "value": 0.8090,
            "error": 0.0149,
            "color": "#9B59B6",
            "significance": "***",
            "delta_vs_baseline": -0.021,
            "p_value_adjusted": 0.0378
          },
          {
            "model": "GIN",
            "value": 0.8047,
            "error": 0.0141,
            "color": "#F18F01",
            "significance": "***",
            "delta_vs_baseline": -0.025,
            "p_value_adjusted": 0.0330
          },
          {
            "model": "ChemBERTa",
            "value": 0.7867,
            "error": 0.0054,
            "color": "#E74C3C",
            "significance": "***",
            "delta_vs_baseline": -0.043,
            "p_value_adjusted": 0.0002
          }
        ]
      },
      "callout_box": {
        "position": "right_of_chart",
        "title": "Honest-Negative Finding",
        "content": [
          {
            "icon": "checkmark",
            "text": "ECFP4-RF wins under scaffold split"
          },
          {
            "icon": "checkmark",
            "text": "Topological descriptors visible in fusion\n(high projection-weight salience)"
          },
          {
            "icon": "cross",
            "text": "But do NOT improve ranking vs. baseline"
          },
          {
            "icon": "chart",
            "text": "Advantage concentrated in OOD tail\n(low-similarity deciles)"
          }
        ],
        "styling": {
          "border": "2px solid #212529",
          "background": "#FFFACD",
          "padding": "8px"
        }
      },
      "conclusion_text": "Conclusion: Classical fingerprints + random forests remain the reference for antimalarial natural products under chemical extrapolation. Learned representations show interpretable signal but do not close the predictive gap."
    }

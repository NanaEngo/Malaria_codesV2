@Article{Onguene2018,
  author       = {Pascal Amoa Onguéné and Conrad V. Simoben and Ghislain W. Fotso and Kerstin Andrae-Marobela and Sami A. Khalid and Bonaventure T. Ngadjui and Luc Meva’a Mbaze and Fidele Ntie-Kang},
  date         = {2018},
  journaltitle = {Computational Biology and Chemistry},
  title        = {In silico toxicity profiling of natural product compound libraries from African flora with anti-malarial and anti-HIV properties},
  doi          = {https://doi.org/10.1016/j.compbiolchem.2017.12.002},
  issn         = {1476-9271},
  pages        = {136-149},
  url          = {https://www.sciencedirect.com/science/article/pii/S1476927117300841},
  volume       = {72},
  abstract     = {This paper describes an analysis of the diversity and chemical toxicity assessment of three chemical libraries of compounds from African flora (the p-ANAPL, AfroMalariaDb, and Afro-HIV), respectively containing compounds exhibiting activities against diverse diseases, malaria and HIV. The diversity of the three data sets was done by comparison of the three most important principal components computed from standard molecular descriptors. This was also done by a study of the most common substructures (MCSS keys). Meanwhile, the in silico toxicity predictions were done through the identification of chemical structural alerts using Lhasa's knowledge based Derek system. The results show that the libraries occupy different chemical space and that only an insignificant part of the respective libraries could exhibit toxicities beyond acceptable limits. The predicted toxicities end points for compounds which were predicted to “plausible” were further discussed in the light of available experimental data in the literature. Toxicity predictions are in agreement when using a machine learning approach that employs graph-based structural signatures. The current study sheds further light towards the use of the studied chemical libraries for virtual screening purposes.},
  keywords     = {Diversity, Drug discovery, Toxicity, , Natural products, Malaria, HIV},
}


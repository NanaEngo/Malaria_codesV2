#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════
# Vina Docking Production Job — Malaria Project V2 CorrectedGrid
#
# Usage (as generated by launch scripts):
#   sbatch --array=0-483%8 -p production \\
#     --export=TARGET=pfDHFR,RECEPTOR=...,CX=...,CY=...,CZ=...,EXHAUSTIVITY=64 \\
#     v2_slurm_vina_production.sbatch
#
# Memory:  capped at 70% of node total (~90GB)
#   - each task uses only ~200 MB RSS
#   - --mem=2G is safe (10× headroom; was 8G — reduced to allow ~44× concurrency)
# CPU:     each task uses 1 core (adjust -c if multi-threaded)
# GPU:     not used by Vina (CPU-only)
# ═══════════════════════════════════════════════════════════════════════
#SBATCH --job-name=v2_docking
#SBATCH --output=/home/nanaengo/Malaria_codesV2/Project1_Chem_space_antimalarial_V2_CorrectedGrid/logs/slurm/v2_docking_%a_%j.log
#SBATCH --error=/home/nanaengo/Malaria_codesV2/Project1_Chem_space_antimalarial_V2_CorrectedGrid/logs/slurm/v2_docking_%a_%j.err
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --time=02:00:00
#SBATCH --partition=debug
# NOTE: Override array range at submission time:
#   sbatch --array=0-483%8 ... v2_slurm_vina_production.sbatch
#   sbatch --array=0-1249%16 ... v2_slurm_vina_production.sbatch (DEKOIS)
# The default below is a placeholder; actual range MUST be passed via CLI.
#SBATCH --array=0-0%1    # PLACEHOLDER — override with --array at submission
#SBATCH --export=ALL

set -euo pipefail

# ── Environment ─────────────────────────────────────────────────────
# Conda: full path to miniforge3
# Direct python path (bypasses broken conda activation scripts)
PYTHON="/home/nanaengo/miniforge3/envs/malaria_md/bin/python"

# ── Configuration (passed via --export) ────────────────────────────
TARGET="${TARGET:-pfDHFR}"
RECEPTOR="${RECEPTOR:?ERROR: RECEPTOR not set}"
CX="${CX:?ERROR: CX not set}"
CY="${CY:?ERROR: CY not set}"
CZ="${CZ:?ERROR: CZ not set}"
EXHAUSTIVITY="${EXHAUSTIVITY:-64}"

PROJECT_DIR="/home/nanaengo/Malaria_codesV2/Project1_Chem_space_antimalarial_V2_CorrectedGrid"
LIGAND_DIR="${PROJECT_DIR}/data/ligands"
RESULTS_DIR="${PROJECT_DIR}/results/v2_docking/${TARGET}"
TASK_ID="${SLURM_ARRAY_TASK_ID}"

mkdir -p "${RESULTS_DIR}"

echo "═══ Vina Docking — Task ${TASK_ID} ═══"
echo "  Target:    ${TARGET}"
echo "  Receptor:  ${RECEPTOR}"
echo "  Center:    ${CX} ${CY} ${CZ}"
echo "  Exhaust:   ${EXHAUSTIVITY}"
echo "  Host:      $(hostname)"
echo "  Memory:    $(free -h | grep Mem)"
echo "  Started:   $(date -u -Iseconds)"

# ── Find the ligand for this array task ────────────────────────────
LIGAND_FILE=$(ls "${LIGAND_DIR}/ligand_$(printf '%04d' ${TASK_ID})"*.pdbqt 2>/dev/null | head -1)
if [ -z "${LIGAND_FILE}" ]; then
  echo "ERROR: No ligand found for task ${TASK_ID}"
  exit 1
fi

OUTPUT="${RESULTS_DIR}/ligand_$(printf '%04d' ${TASK_ID})_docked.pdbqt"
LOG="${RESULTS_DIR}/ligand_$(printf '%04d' ${TASK_ID})_vina.log"

# ── Run AutoDock Vina ──────────────────────────────────────────────
# Grid box: 20×20×20 Å (standard)
vina \
  --receptor "${RECEPTOR}" \
  --ligand "${LIGAND_FILE}" \
  --out "${OUTPUT}" \
  --center_x ${CX} --center_y ${CY} --center_z ${CZ} \
  --size_x 20 --size_y 20 --size_z 20 \
  --exhaustiveness ${EXHAUSTIVITY} \
  --num_modes 5 \
  --log "${LOG}"

# ── Validation ─────────────────────────────────────────────────────
if [ -s "${OUTPUT}" ]; then
  VINA_SCORE=$(grep -m1 'REMARK VINA RESULT:' "${OUTPUT}" | awk '{print $4}')
  echo "  Vina score: ${VINA_SCORE}"
  echo "  Status:     OK"
else
  echo "  Status:     FAILED (no output)"
  exit 1
fi

echo "═══ Task ${TASK_ID} complete: $(date -u -Iseconds) ═══"
